<?xml version="1.0" encoding="utf-8"?>
<!-- Cobertura para SonarQube: la usa tools/analizar-sonar.sh al correr dotnet test. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>opencover</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
